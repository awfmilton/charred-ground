# Charred Ground server & account configuration
PORT=8187
HOST=127.0.0.1
# Set to 1 or true when running behind a reverse proxy so rate limiting reads X-Forwarded-For
TRUST_PROXY=
# MySQL database host (e.g. mysql.example.com); leave blank to use local SQLite via DB_PATH
DB_HOST=
# MySQL database port (defaults to 3306 when blank)
DB_PORT=3306
# MySQL database username (required when DB_HOST is set)
DB_USER=
# MySQL database password: paste it between single quotes, exactly as it is, e.g. DB_PASSWORD='p#ss w0rd'
# (unquoted, everything from a # on is dropped as a comment; if the password contains ' use backticks instead)
DB_PASSWORD=''
# MySQL database name (required when DB_HOST is set)
DB_NAME=
# MySQL TLS mode when DB_HOST is set: verify (CA + optional pin), require (encrypted, unverified), off (plaintext)
DB_SSL=verify
# CA certificate PEM for DB_SSL=verify; relative paths resolve from the project root
DB_SSL_CA=certs/dreamhost-mysql-ca.pem
# Optional sha256 pin of the server certificate (colon-separated hex, case-insensitive); enforced post-handshake on the live TLS socket (mysql2 ignores ssl.checkServerIdentity)
DB_SSL_FINGERPRINT=0E:AA:2F:68:07:5B:AC:BB:AE:28:D4:66:77:7D:EF:28:79:FE:03:A1:8F:40:2F:37:F5:DA:67:98:6E:62:5B:71
# Local SQLite database file path used when DB_HOST is blank
DB_PATH=data/charred-ground.sqlite
SESSION_TTL_HOURS=168

# Email verification sender (leave blank in development to log codes to stdout)
EMAIL_FROM=
EMAIL_SMTP_URL=

# Google OAuth 2.0 placeholders
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=

# Discord OAuth 2.0 placeholders
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_DISCORD_REDIRECT_URI=

# Facebook OAuth 2.0 placeholders
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_REDIRECT_URI=

# Twitter / X OAuth 2.0 placeholders
OAUTH_TWITTER_CLIENT_ID=
OAUTH_TWITTER_CLIENT_SECRET=
OAUTH_TWITTER_REDIRECT_URI=

# Optional owner-managed AI game decisions (Gemini and OpenAI). Never put these values in browser code.
# Leave either key or model blank for a provider to keep that provider disabled. Choose a model available to your account.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional server AI tuning knobs (integers, clamped; defaults match standard models; use AI_TIMEOUT_MS=12000 and OPENAI_MAX_COMPLETION_TOKENS=2000 for reasoning models like gpt-5-mini)
AI_TIMEOUT_MS=3500
AI_ACCOUNT_RATE_PER_MIN=12
OPENAI_MAX_COMPLETION_TOKENS=400

# ---- Telegram Mini App & bot (docs/TELEGRAM_MINI_APP.md). Leave TELEGRAM_BOT_TOKEN blank to disable. ----
# Bot token from @BotFather (secret: never commit it)
TELEGRAM_BOT_TOKEN=
# Random 16-256 chars [A-Za-z0-9_-]; Telegram sends it in X-Telegram-Bot-Api-Secret-Token on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Bot username without @, used for t.me deep links
TELEGRAM_BOT_USERNAME=
# Optional /newapp short name (e.g. play) for t.me/<bot>/<app> links; blank uses the Main Mini App link
TELEGRAM_APP_SHORT_NAME=
# HTTPS origin that serves index.html and /api (webhook, menu button and Story image URLs)
PUBLIC_BASE_URL=
# 1 to use Telegram's test environment (api.telegram.org/bot<token>/test/...)
TELEGRAM_TEST_ENV=
# Numeric Telegram user ids allowed to run /refund <charge_id> (comma-separated)
TELEGRAM_ADMIN_IDS=
# Shown by /support and /paysupport (e.g. @your_support or an email)
TELEGRAM_SUPPORT_CONTACT=
# Optional link to full terms shown by /terms
TELEGRAM_TERMS_URL=
# Custom emoji id offered as a champion emoji status to the #1 commander (optional)
TELEGRAM_CHAMPION_EMOJI_ID=
# Stars store: 0 to close it; JSON price overrides; comma list of SKUs to hide
TELEGRAM_STORE_ENABLED=1
TELEGRAM_STORE_PRICES=
TELEGRAM_STORE_DISABLED=
# 1 to require the Mastermind AI pass (or Supporter) for server AI when a player is Telegram-linked
TELEGRAM_AI_PASS_REQUIRED=
# Max age of Telegram launch data in seconds (default 86400)
TELEGRAM_INITDATA_MAX_AGE_SEC=

# ---- TURN relay for phones behind carrier NAT (coturn use-auth-secret). Optional. ----
TURN_SECRET=
TURN_URLS=
TURN_TTL_SEC=
