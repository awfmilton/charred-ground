# Charred Ground server & account configuration
PORT=8187
HOST=127.0.0.1
# Set to 1 or true when running behind a reverse proxy so rate limiting reads X-Forwarded-For
TRUST_PROXY=
# Production MySQL URL (e.g. mysql://user:pass@host:3306/db); leave blank to use local SQLite via DB_PATH
DATABASE_URL=
DB_PATH=data/charred-ground.sqlite
SESSION_TTL_HOURS=168

# Email verification sender (leave blank in development to log codes to stdout)
EMAIL_FROM=
EMAIL_SMTP_URL=

# Google OAuth 2.0 placeholders
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=

# Discord OAuth 2.0 placeholders
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_DISCORD_REDIRECT_URI=

# Facebook OAuth 2.0 placeholders
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_REDIRECT_URI=

# Twitter / X OAuth 2.0 placeholders
OAUTH_TWITTER_CLIENT_ID=
OAUTH_TWITTER_CLIENT_SECRET=
OAUTH_TWITTER_REDIRECT_URI=
